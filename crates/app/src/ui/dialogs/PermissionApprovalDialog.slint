import { FilledButton, TextButton, ListView, MaterialText, MaterialTypography, MaterialPalette, MaterialStyleMetrics } from "@material";

// Save-time permission approval overlay. Shown when `visible` is true.
export component PermissionApprovalDialog {
    in property <[string]> permissions;

    callback approve();
    callback cancel();

    // Scrim
    Rectangle {
        width: 100%;
        height: 100%;
        background: MaterialPalette.background-modal;

        TouchArea {} // swallow backdrop clicks

        Rectangle {
            width: 460px;
            height: 380px;
            border-radius: MaterialStyleMetrics.border_radius_28;
            background: MaterialPalette.surface-container-high;

            VerticalLayout {
                padding: MaterialStyleMetrics.padding_24;
                spacing: MaterialStyleMetrics.spacing_16;

                MaterialText {
                    text: @tr("Approve permissions");
                    style: MaterialTypography.headline-small;
                    color: MaterialPalette.on-surface;
                }

                MaterialText {
                    text: @tr("Saving this macro requires granting the following permissions:");
                    wrap: word-wrap;
                    style: MaterialTypography.body-medium;
                    color: MaterialPalette.on-surface-variant;
                }

                ListView {
                    vertical-stretch: 1;

                    for label in root.permissions : MaterialText {
                        height: 26px;
                        text: "• " + label;
                        style: MaterialTypography.body-medium;
                        color: MaterialPalette.on-surface;
                    }
                }

                if root.permissions.length == 0 : MaterialText {
                    text: @tr("No sensitive permissions are required.");
                    style: MaterialTypography.body-medium;
                    color: MaterialPalette.on-surface-variant;
                }

                HorizontalLayout {
                    spacing: MaterialStyleMetrics.spacing_8;
                    alignment: end;

                    TextButton {
                        text: @tr("Cancel");
                        height: 40px;
                        clicked => { root.cancel(); }
                    }
                    FilledButton {
                        text: @tr("Approve");
                        height: 40px;
                        clicked => { root.approve(); }
                    }
                }
            }
        }
    }
}
