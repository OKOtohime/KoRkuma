import { Button, CheckBox, ListView, LineEdit, TabWidget, TextEdit, ComboBox, ScrollView, Palette } from "std-widgets.slint";

// ── Shared structs ────────────────────────────────────────────────────────────

export struct MacroItem {
    id: string,
    name: string,
    enabled: bool,
}

export struct LogEntry {
    message: string,
}

export struct TriggerRow {
    kind: string,
    summary: string,
}

/// One row in the flat constraint tree display.
export struct ConstraintRow {
    depth: int,
    kind: string,        // "Always" | "Not" | "All" | "Any" | "Leaf"
    leaf-type: string,   // for Leaf: "ActiveWindow" | "TimeRange" | ...
    summary: string,
    params-json: string,
}

/// One row in the flat workflow tree display.
export struct WorkflowRow {
    depth: int,
    kind: string,        // "Action" | "Seq" | "Parallel" | "If" | "While" | ...
    action-type: string, // for Action: "Notify" | "RunCommand" | ...
    summary: string,
    params-json: string,
    is-container: bool,
}

// ── Main window ───────────────────────────────────────────────────────────────

export component MainWindow inherits Window {
    width: 1280px;
    height: 680px;
    title: @tr("Koakuma — Automation Engine");

    // ── Model properties ──────────────────────────────────────────────────────
    in property <[MacroItem]> macros;
    in-out property <int> selected-index: -1;
    in property <[LogEntry]> logs;

    // Macro name editor
    in-out property <string> macro-name: "";

    // Triggers tab
    in property <[TriggerRow]> trigger-rows;
    in-out property <int> trigger-selected: -1;
    in-out property <string> trigger-kind: "Manual";
    in-out property <string> trigger-cron: "* * * * *";
    in-out property <string> trigger-title-pat: "";
    in-out property <bool> trigger-use-regex: false;
    in-out property <string> trigger-proc-name: "";
    in-out property <string> trigger-proc-event: "Started";
    in-out property <string> trigger-hotkey: "";

    // Constraint tree
    in property <[ConstraintRow]> constraint-rows;
    in-out property <int> constraint-selected: -1;
    in-out property <string> constraint-edit-json: "";

    // Workflow tree
    in property <[WorkflowRow]> workflow-rows;
    in-out property <int> workflow-selected: -1;
    in-out property <string> workflow-edit-json: "";

    // Target selector fields (for the currently selected Interact action)
    in-out property <string> target-type: "Foreground";
    in-out property <string> target-pattern: "";
    in-out property <string> on-no-bg: "Degrade";

    // Sidebar collapse state
    private property <bool> sidebar-collapsed: false;

    // ── Callbacks ─────────────────────────────────────────────────────────────
    callback add-macro();
    callback delete-macro(int);
    callback toggle-enabled(int, bool);
    callback trigger-macro(int);
    callback dry-run-macro(int);
    callback macro-selected(int);
    callback rename-macro(int, string);
    callback move-macro-up(int);
    callback move-macro-down(int);

    // Trigger callbacks
    callback trigger-select(int);
    callback trigger-add(string);
    callback trigger-delete(int);
    callback trigger-apply();

    // Constraint tree callbacks
    callback constraint-node-selected(int);
    callback constraint-update-node(int, string);
    callback constraint-delete-node(int);
    callback constraint-add-leaf(string);   // leaf type name
    callback constraint-wrap(string);       // "And" | "Or" | "Not" — wraps selected node
    callback constraint-move-up(int);
    callback constraint-move-down(int);

    // Workflow tree callbacks
    callback workflow-node-selected(int);
    callback workflow-update-node(int, string);
    callback workflow-delete-node(int);
    callback workflow-add-action(string);   // action type name
    callback workflow-add-if();
    callback workflow-add-parallel();
    callback workflow-move-up(int);
    callback workflow-move-down(int);

    HorizontalLayout {
        spacing: 0px;

        // ── Sidebar: collapsible macro list ───────────────────────────────────
        sidebar-clip := Rectangle {
            width: root.sidebar-collapsed ? 0px : 240px;
            clip: true;
            animate width { duration: 200ms; easing: ease-in-out; }

            // Inner panel stays at 240px; parent clips it during animation.
            Rectangle {
                width: 240px;
                height: parent.height;

                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;

                    Text {
                        text: @tr("Macros");
                        font-size: 14px;
                        font-weight: 700;
                    }

                    ListView {
                        vertical-stretch: 1;

                        for item[idx] in root.macros: Rectangle {
                            height: 48px;
                            background: idx == root.selected-index ? Palette.selection-background : transparent;
                            border-radius: 5px;

                            TouchArea {
                                clicked => {
                                    root.selected-index = idx;
                                    root.macro-selected(idx);
                                }
                            }

                            VerticalLayout {
                                padding: 2px;
                                spacing: 0px;

                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    spacing: 4px;
                                    alignment: center;

                                    CheckBox {
                                        checked: item.enabled;
                                        toggled => { root.toggle-enabled(idx, self.checked); }
                                    }

                                    Text {
                                        text: item.name;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                        font-size: 12px;
                                        color: idx == root.selected-index ? Palette.selection-foreground : Palette.foreground;
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 26px;
                                    padding-right: 4px;
                                    spacing: 3px;
                                    height: 26px;

                                    Button {
                                        text: @tr("▶ Run");
                                        height: 22px;
                                        clicked => {
                                            root.selected-index = idx;
                                            root.trigger-macro(idx);
                                            root.macro-selected(idx);
                                        }
                                    }

                                    Button {
                                        text: @tr("Dry ▶");
                                        height: 22px;
                                        clicked => {
                                            root.selected-index = idx;
                                            root.dry-run-macro(idx);
                                            root.macro-selected(idx);
                                        }
                                    }

                                    Button {
                                        text: "✕";
                                        width: 22px;
                                        height: 22px;
                                        clicked => { root.delete-macro(idx); }
                                    }

                                    Button {
                                        text: "↑";
                                        width: 22px;
                                        height: 22px;
                                        clicked => { root.move-macro-up(idx); }
                                    }

                                    Button {
                                        text: "↓";
                                        width: 22px;
                                        height: 22px;
                                        clicked => { root.move-macro-down(idx); }
                                    }
                                }
                            }
                        }
                    }

                    Button {
                        text: @tr("+ Add Macro");
                        clicked => { root.add-macro(); }
                    }
                }
            }
        }

        // ── Toggle strip ──────────────────────────────────────────────────────
        Rectangle {
            width: 20px;
            background: toggle-ta.has-hover ? Palette.foreground.with-alpha(0.08) : transparent;

            // Vertical border line
            Rectangle {
                x: 0;
                y: 0;
                width: 1px;
                height: parent.height;
                background: Palette.border;
            }

            Text {
                width: parent.width;
                height: parent.height;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 10px;
                text: root.sidebar-collapsed ? "▶" : "◀";
                color: Palette.foreground;
            }

            toggle-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.sidebar-collapsed = !root.sidebar-collapsed; }
            }
        }

        // ── Right panel: name editor + tab editor + log ───────────────────────
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;

            // Macro name editor (visible only when a macro is selected)
            if root.selected-index >= 0: HorizontalLayout {
                height: 34px;
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 4px;
                padding-bottom: 2px;
                spacing: 6px;

                Text {
                    text: @tr("Name:");
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                    width: 44px;
                }

                LineEdit {
                    text <=> root.macro-name;
                    font-size: 12px;
                    horizontal-stretch: 1;
                    accepted => { root.rename-macro(root.selected-index, self.text); }
                }
            }

            // 3-tab editor
            TabWidget {
                vertical-stretch: 1;

                // ── Triggers tab ──────────────────────────────────────────────
                Tab {
                    title: @tr("Triggers");
                    VerticalLayout {
                        padding: 4px;
                        spacing: 4px;

                        // Add trigger buttons
                        HorizontalLayout {
                            height: 28px;
                            spacing: 4px;
                            alignment: start;

                            Text {
                                text: @tr("+ Trigger:");
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            Button {
                                text: @tr("Manual");
                                height: 24px;
                                clicked => { root.trigger-add("Manual"); }
                            }
                            Button {
                                text: @tr("Schedule");
                                height: 24px;
                                clicked => { root.trigger-add("Schedule"); }
                            }
                            Button {
                                text: @tr("Hotkey");
                                height: 24px;
                                clicked => { root.trigger-add("Hotkey"); }
                            }
                            Button {
                                text: @tr("Window");
                                height: 24px;
                                clicked => { root.trigger-add("WindowFocus"); }
                            }
                            Button {
                                text: @tr("Process");
                                height: 24px;
                                clicked => { root.trigger-add("Process"); }
                            }
                        }

                        // Trigger list
                        ListView {
                            vertical-stretch: 1;
                            min-height: 80px;

                            for row[i] in root.trigger-rows: Rectangle {
                                height: 26px;
                                background: i == root.trigger-selected
                                    ? Palette.selection-background
                                    : (mod(i, 2) == 0 ? Palette.alternate-background : Palette.background);
                                border-radius: 3px;

                                TouchArea {
                                    clicked => {
                                        root.trigger-selected = i;
                                        root.trigger-select(i);
                                    }
                                }

                                HorizontalLayout {
                                    padding-top: 2px;
                                    padding-bottom: 2px;
                                    padding-left: 6px;
                                    spacing: 6px;

                                    Text {
                                        text: row.kind;
                                        font-size: 11px;
                                        font-weight: 600;
                                        width: 84px;
                                        vertical-alignment: center;
                                        color: i == root.trigger-selected ? Palette.selection-foreground : #4477dd;
                                    }

                                    Text {
                                        text: row.summary;
                                        font-size: 11px;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        color: i == root.trigger-selected ? Palette.selection-foreground : Palette.foreground;
                                    }
                                }
                            }
                        }

                        // Separator
                        Rectangle { height: 1px; background: Palette.border; }

                        // Type-specific editor (conditional)
                        if root.trigger-kind == "Schedule": HorizontalLayout {
                            height: 26px;
                            spacing: 6px;
                            Text { text: @tr("Cron:"); font-size: 11px; vertical-alignment: center; width: 40px; }
                            LineEdit { text <=> root.trigger-cron; font-size: 11px; horizontal-stretch: 1; placeholder-text: "* * * * *"; }
                        }

                        if root.trigger-kind == "WindowFocus": HorizontalLayout {
                            height: 26px;
                            spacing: 6px;
                            Text { text: @tr("Title:"); font-size: 11px; vertical-alignment: center; width: 40px; }
                            LineEdit { text <=> root.trigger-title-pat; font-size: 11px; horizontal-stretch: 1; placeholder-text: "window title pattern"; }
                            CheckBox { text: @tr("Regex"); checked <=> root.trigger-use-regex; }
                        }

                        if root.trigger-kind == "Process": HorizontalLayout {
                            height: 26px;
                            spacing: 6px;
                            Text { text: @tr("Name:"); font-size: 11px; vertical-alignment: center; width: 40px; }
                            LineEdit { text <=> root.trigger-proc-name; font-size: 11px; horizontal-stretch: 1; placeholder-text: "process name"; }
                            ComboBox { model: ["Started", "Stopped"]; current-value <=> root.trigger-proc-event; height: 24px; width: 90px; }
                        }

                        if root.trigger-kind == "Hotkey": HorizontalLayout {
                            height: 26px;
                            spacing: 6px;
                            Text { text: @tr("Keys:"); font-size: 11px; vertical-alignment: center; width: 40px; }
                            LineEdit { text <=> root.trigger-hotkey; font-size: 11px; horizontal-stretch: 1; placeholder-text: "e.g. Ctrl+F1"; }
                        }

                        if root.trigger-kind == "Manual": HorizontalLayout {
                            height: 26px;
                            Text {
                                text: @tr("Manual trigger — no configuration needed.");
                                font-size: 11px;
                                vertical-alignment: center;
                                color: Palette.foreground;
                            }
                        }

                        // Delete / Apply row
                        HorizontalLayout {
                            height: 26px;
                            spacing: 4px;

                            Button {
                                text: @tr("Delete");
                                enabled: root.trigger-selected >= 0;
                                height: 24px;
                                clicked => { root.trigger-delete(root.trigger-selected); }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Button {
                                text: @tr("Apply");
                                enabled: root.trigger-selected >= 0 && root.trigger-kind != "Manual";
                                height: 24px;
                                clicked => { root.trigger-apply(); }
                            }
                        }
                    }
                }

                // ── Constraints tab ───────────────────────────────────────────
                Tab {
                    title: @tr("Constraints");
                    VerticalLayout {
                        padding: 4px;
                        spacing: 4px;

                        // Add / wrap buttons
                        HorizontalLayout {
                            height: 28px;
                            spacing: 4px;
                            alignment: start;

                            Text {
                                text: @tr("+ Leaf:");
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            Button {
                                text: @tr("Window");
                                height: 24px;
                                clicked => { root.constraint-add-leaf("ActiveWindow"); }
                            }
                            Button {
                                text: @tr("Time");
                                height: 24px;
                                clicked => { root.constraint-add-leaf("TimeRange"); }
                            }
                            Button {
                                text: @tr("Var");
                                height: 24px;
                                clicked => { root.constraint-add-leaf("VarCompare"); }
                            }
                            Button {
                                text: @tr("Expr");
                                height: 24px;
                                clicked => { root.constraint-add-leaf("Expression"); }
                            }

                            Rectangle { width: 8px; }

                            Text {
                                text: @tr("Wrap:");
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            Button {
                                text: @tr("AND");
                                height: 24px;
                                clicked => { root.constraint-wrap("And"); }
                            }
                            Button {
                                text: @tr("OR");
                                height: 24px;
                                clicked => { root.constraint-wrap("Or"); }
                            }
                            Button {
                                text: @tr("NOT");
                                height: 24px;
                                clicked => { root.constraint-wrap("Not"); }
                            }
                        }

                        // Tree list
                        ListView {
                            vertical-stretch: 1;
                            min-height: 120px;

                            for row[i] in root.constraint-rows: Rectangle {
                                height: 26px;
                                background: i == root.constraint-selected
                                    ? Palette.selection-background
                                    : (mod(i, 2) == 0 ? Palette.alternate-background : Palette.background);
                                border-radius: 3px;

                                TouchArea {
                                    clicked => {
                                        root.constraint-selected = i;
                                        root.constraint-node-selected(i);
                                    }
                                }

                                HorizontalLayout {
                                    padding-top: 2px;
                                    padding-bottom: 2px;
                                    padding-left: 4px;
                                    spacing: 0px;

                                    // Depth indent
                                    Rectangle { width: row.depth * 16px; }

                                    // Kind icon
                                    Text {
                                        width: 20px;
                                        text: row.kind == "All" ? "⊓"
                                            : row.kind == "Any" ? "⊔"
                                            : row.kind == "Not" ? "¬"
                                            : row.kind == "Leaf" ? "◆"
                                            : "◇";
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        color: row.kind == "All" ? #4477dd
                                            : row.kind == "Any" ? #dd6633
                                            : row.kind == "Not" ? #bb44bb
                                            : #44bb66;
                                    }

                                    Text {
                                        text: row.summary;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        color: i == root.constraint-selected ? Palette.selection-foreground : Palette.foreground;
                                    }

                                    // Reorder buttons
                                    Button {
                                        text: "↑";
                                        width: 20px;
                                        height: 20px;
                                        clicked => { root.constraint-move-up(i); }
                                    }
                                    Button {
                                        text: "↓";
                                        width: 20px;
                                        height: 20px;
                                        clicked => { root.constraint-move-down(i); }
                                    }
                                }
                            }
                        }

                        // Separator
                        Rectangle { height: 1px; background: Palette.border; }

                        // Edit panel
                        HorizontalLayout {
                            height: 22px;
                            spacing: 4px;

                            Text {
                                text: @tr("Params JSON:");
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Button {
                                text: @tr("Delete");
                                height: 22px;
                                enabled: root.constraint-selected >= 0;
                                clicked => { root.constraint-delete-node(root.constraint-selected); }
                            }
                        }

                        TextEdit {
                            height: 110px;
                            text <=> root.constraint-edit-json;
                            font-family: "monospace";
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        Button {
                            height: 26px;
                            text: @tr("Update Constraint");
                            enabled: root.constraint-selected >= 0;
                            clicked => {
                                root.constraint-update-node(
                                    root.constraint-selected,
                                    root.constraint-edit-json
                                );
                            }
                        }
                    }
                }

                // ── Workflow tab ──────────────────────────────────────────────
                Tab {
                    title: @tr("Workflow");
                    VerticalLayout {
                        padding: 4px;
                        spacing: 4px;

                        // Add action buttons
                        HorizontalLayout {
                            height: 28px;
                            spacing: 4px;
                            alignment: start;

                            Text {
                                text: @tr("+ Action:");
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            Button {
                                text: @tr("Notify");
                                height: 24px;
                                clicked => { root.workflow-add-action("Notify"); }
                            }
                            Button {
                                text: @tr("Run");
                                height: 24px;
                                clicked => { root.workflow-add-action("RunCommand"); }
                            }
                            Button {
                                text: @tr("Delay");
                                height: 24px;
                                clicked => { root.workflow-add-action("Delay"); }
                            }
                            Button {
                                text: @tr("Script");
                                height: 24px;
                                clicked => { root.workflow-add-action("RunScript"); }
                            }
                            Button {
                                text: @tr("Interact");
                                height: 24px;
                                clicked => { root.workflow-add-action("Interact"); }
                            }

                            Rectangle { width: 8px; }

                            Text {
                                text: @tr("Control:");
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            Button {
                                text: @tr("If");
                                height: 24px;
                                clicked => { root.workflow-add-if(); }
                            }
                            Button {
                                text: @tr("Parallel");
                                height: 24px;
                                clicked => { root.workflow-add-parallel(); }
                            }
                        }

                        // Workflow tree list
                        ListView {
                            vertical-stretch: 1;
                            min-height: 100px;

                            for row[i] in root.workflow-rows: Rectangle {
                                height: 26px;
                                background: i == root.workflow-selected
                                    ? Palette.selection-background
                                    : (mod(i, 2) == 0 ? Palette.alternate-background : Palette.background);
                                border-radius: 3px;

                                TouchArea {
                                    clicked => {
                                        root.workflow-selected = i;
                                        root.workflow-node-selected(i);
                                    }
                                }

                                HorizontalLayout {
                                    padding-top: 2px;
                                    padding-bottom: 2px;
                                    padding-left: 4px;
                                    spacing: 0px;

                                    // Depth indent
                                    Rectangle { width: row.depth * 16px; }

                                    // Kind icon
                                    Text {
                                        width: 20px;
                                        text: row.kind == "Action" ? "▣"
                                            : row.kind == "Seq" ? "↓"
                                            : row.kind == "Parallel" ? "⇉"
                                            : row.kind == "If" ? "?"
                                            : row.kind == "While" ? "↺"
                                            : row.kind == "Then" ? "▷"
                                            : row.kind == "Else" ? "▶"
                                            : "○";
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        color: row.kind == "Action" ? #44aa77
                                            : row.kind == "If" ? #bbaa33
                                            : row.kind == "Parallel" ? #4477bb
                                            : Palette.foreground;
                                    }

                                    Text {
                                        text: row.summary;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        color: i == root.workflow-selected ? Palette.selection-foreground : Palette.foreground;
                                    }

                                    // Reorder buttons (disabled for Then/Else structural labels)
                                    Button {
                                        text: "↑";
                                        width: 20px;
                                        height: 20px;
                                        enabled: row.kind != "Then" && row.kind != "Else";
                                        clicked => { root.workflow-move-up(i); }
                                    }
                                    Button {
                                        text: "↓";
                                        width: 20px;
                                        height: 20px;
                                        enabled: row.kind != "Then" && row.kind != "Else";
                                        clicked => { root.workflow-move-down(i); }
                                    }
                                }
                            }
                        }

                        // Separator
                        Rectangle { height: 1px; background: Palette.border; }

                        // Target selector (for Interact actions)
                        HorizontalLayout {
                            height: 26px;
                            spacing: 4px;

                            Text {
                                text: @tr("Target:");
                                font-size: 11px;
                                vertical-alignment: center;
                                width: 46px;
                            }

                            ComboBox {
                                model: ["Foreground", "Window", "Process", "BrowserTab"];
                                current-value <=> root.target-type;
                                height: 24px;
                                width: 110px;
                            }

                            TextEdit {
                                text <=> root.target-pattern;
                                font-size: 11px;
                                horizontal-stretch: 1;
                                height: 24px;
                                enabled: root.target-type != "Foreground";
                            }

                            Text {
                                text: @tr("OnNoBg:");
                                font-size: 11px;
                                vertical-alignment: center;
                                width: 52px;
                            }

                            ComboBox {
                                model: ["Degrade", "Fail", "Queue"];
                                current-value <=> root.on-no-bg;
                                height: 24px;
                                width: 80px;
                            }
                        }

                        // Params edit
                        HorizontalLayout {
                            height: 22px;
                            spacing: 4px;

                            Text {
                                text: @tr("Params JSON:");
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Button {
                                text: @tr("Delete");
                                height: 22px;
                                enabled: root.workflow-selected >= 0;
                                clicked => { root.workflow-delete-node(root.workflow-selected); }
                            }
                        }

                        TextEdit {
                            height: 90px;
                            text <=> root.workflow-edit-json;
                            font-family: "monospace";
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        Button {
                            height: 26px;
                            text: @tr("Update Action");
                            enabled: root.workflow-selected >= 0;
                            clicked => {
                                root.workflow-update-node(
                                    root.workflow-selected,
                                    root.workflow-edit-json
                                );
                            }
                        }
                    }
                }
            }

            // Horizontal separator
            Rectangle {
                height: 1px;
                background: Palette.border;
            }

            // Log panel
            VerticalLayout {
                height: 130px;
                padding: 6px;
                spacing: 2px;

                Text {
                    text: @tr("Log");
                    font-size: 12px;
                    font-weight: 700;
                    height: 18px;
                }

                ListView {
                    vertical-stretch: 1;

                    for entry in root.logs: Text {
                        text: entry.message;
                        font-family: "monospace";
                        font-size: 11px;
                        height: 16px;
                    }
                }
            }
        }
    }
}