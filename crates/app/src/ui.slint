import { Button, CheckBox, ListView, TabWidget, TextEdit, ComboBox, ScrollView, Palette } from "std-widgets.slint";

// ── Shared structs ────────────────────────────────────────────────────────────

export struct MacroItem {
    id: string,
    name: string,
    enabled: bool,
}

export struct LogEntry {
    message: string,
}

/// One row in the flat constraint tree display.
export struct ConstraintRow {
    depth: int,
    kind: string,        // "Always" | "Not" | "All" | "Any" | "Leaf"
    leaf-type: string,   // for Leaf: "ActiveWindow" | "TimeRange" | ...
    summary: string,
    params-json: string,
}

/// One row in the flat workflow tree display.
export struct WorkflowRow {
    depth: int,
    kind: string,        // "Action" | "Seq" | "Parallel" | "If" | "While" | ...
    action-type: string, // for Action: "Notify" | "RunCommand" | ...
    summary: string,
    params-json: string,
    is-container: bool,
}

// ── Main window ───────────────────────────────────────────────────────────────

export component MainWindow inherits Window {
    width: 1060px;
    height: 680px;
    title: @tr("Koakuma — Automation Engine");

    // ── Model properties ──────────────────────────────────────────────────────
    in property <[MacroItem]> macros;
    in-out property <int> selected-index: -1;
    in property <[LogEntry]> logs;

    // Triggers tab (JSON preview, unchanged)
    in property <string> selected-triggers: "";

    // Constraint tree
    in property <[ConstraintRow]> constraint-rows;
    in-out property <int> constraint-selected: -1;
    in-out property <string> constraint-edit-json: "";

    // Workflow tree
    in property <[WorkflowRow]> workflow-rows;
    in-out property <int> workflow-selected: -1;
    in-out property <string> workflow-edit-json: "";

    // Target selector fields (for the currently selected Interact action)
    in-out property <string> target-type: "Foreground";
    in-out property <string> target-pattern: "";
    in-out property <string> on-no-bg: "Degrade";

    // ── Callbacks ─────────────────────────────────────────────────────────────
    callback add-macro();
    callback delete-macro(int);
    callback toggle-enabled(int, bool);
    callback trigger-macro(int);
    callback dry-run-macro(int);
    callback macro-selected(int);

    // Constraint tree callbacks
    callback constraint-node-selected(int);
    callback constraint-update-node(int, string);
    callback constraint-delete-node(int);
    callback constraint-add-leaf(string);   // leaf type name
    callback constraint-wrap(string);       // "And" | "Or" | "Not"

    // Workflow tree callbacks
    callback workflow-node-selected(int);
    callback workflow-update-node(int, string);
    callback workflow-delete-node(int);
    callback workflow-add-action(string);   // action type name
    callback workflow-add-if();
    callback workflow-add-parallel();

    HorizontalLayout {
        spacing: 0px;

        // ── Left panel: macro list ────────────────────────────────────────────
        VerticalLayout {
            width: 240px;
            padding: 8px;
            spacing: 6px;

            Text {
                text: @tr("Macros");
                font-size: 14px;
                font-weight: 700;
            }

            ListView {
                vertical-stretch: 1;

                for item[idx] in root.macros: Rectangle {
                    height: 48px;
                    background: idx == root.selected-index ? Palette.selection-background : transparent;
                    border-radius: 5px;

                    TouchArea {
                        clicked => {
                            root.selected-index = idx;
                            root.macro-selected(idx);
                        }
                    }

                    VerticalLayout {
                        padding: 2px;
                        spacing: 0px;

                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            spacing: 4px;
                            alignment: center;

                            CheckBox {
                                checked: item.enabled;
                                toggled => { root.toggle-enabled(idx, self.checked); }
                            }

                            Text {
                                text: item.name;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                                font-size: 12px;
                                color: idx == root.selected-index ? Palette.selection-foreground : Palette.foreground;
                            }
                        }

                        HorizontalLayout {
                            padding-left: 26px;
                            padding-right: 4px;
                            spacing: 3px;
                            height: 26px;

                            Button {
                                text: @tr("▶ Run");
                                height: 22px;
                                clicked => {
                                    root.selected-index = idx;
                                    root.trigger-macro(idx);
                                    root.macro-selected(idx);
                                }
                            }

                            Button {
                                text: @tr("Dry ▶");
                                height: 22px;
                                clicked => {
                                    root.selected-index = idx;
                                    root.dry-run-macro(idx);
                                    root.macro-selected(idx);
                                }
                            }

                            Button {
                                text: "✕";
                                width: 24px;
                                height: 22px;
                                clicked => { root.delete-macro(idx); }
                            }
                        }
                    }
                }
            }

            Button {
                text: @tr("+ Add Macro");
                clicked => { root.add-macro(); }
            }
        }

        // Vertical separator
        Rectangle {
            width: 1px;
            background: Palette.border;
        }

        // ── Right panel: editor + log ─────────────────────────────────────────
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;

            // 3-tab editor
            TabWidget {
                vertical-stretch: 1;

                // ── Triggers tab (JSON preview) ───────────────────────────────
                Tab {
                    title: @tr("Triggers");
                    TextEdit {
                        text: root.selected-triggers;
                        read-only: true;
                        font-family: "monospace";
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }

                // ── Constraints tab ───────────────────────────────────────────
                Tab {
                    title: @tr("Constraints");
                    VerticalLayout {
                        padding: 4px;
                        spacing: 4px;

                        // Add / wrap buttons
                        HorizontalLayout {
                            height: 28px;
                            spacing: 4px;
                            alignment: start;

                            Text {
                                text: @tr("+ Leaf:");
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            Button {
                                text: @tr("Window");
                                height: 24px;
                                clicked => { root.constraint-add-leaf("ActiveWindow"); }
                            }
                            Button {
                                text: @tr("Time");
                                height: 24px;
                                clicked => { root.constraint-add-leaf("TimeRange"); }
                            }
                            Button {
                                text: @tr("Var");
                                height: 24px;
                                clicked => { root.constraint-add-leaf("VarCompare"); }
                            }
                            Button {
                                text: @tr("Expr");
                                height: 24px;
                                clicked => { root.constraint-add-leaf("Expression"); }
                            }

                            Rectangle { width: 8px; }

                            Text {
                                text: @tr("Wrap:");
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            Button {
                                text: @tr("AND");
                                height: 24px;
                                clicked => { root.constraint-wrap("And"); }
                            }
                            Button {
                                text: @tr("OR");
                                height: 24px;
                                clicked => { root.constraint-wrap("Or"); }
                            }
                            Button {
                                text: @tr("NOT");
                                height: 24px;
                                clicked => { root.constraint-wrap("Not"); }
                            }
                        }

                        // Tree list
                        ListView {
                            vertical-stretch: 1;
                            min-height: 120px;

                            for row[i] in root.constraint-rows: Rectangle {
                                height: 26px;
                                background: i == root.constraint-selected
                                    ? Palette.selection-background
                                    : (mod(i, 2) == 0 ? Palette.alternate-background : Palette.background);
                                border-radius: 3px;

                                TouchArea {
                                    clicked => {
                                        root.constraint-selected = i;
                                        root.constraint-node-selected(i);
                                    }
                                }

                                HorizontalLayout {
                                    padding-top: 2px;
                                    padding-bottom: 2px;
                                    padding-left: 4px;
                                    spacing: 0px;

                                    // Depth indent
                                    Rectangle { width: row.depth * 16px; }

                                    // Kind icon
                                    Text {
                                        width: 20px;
                                        text: row.kind == "All" ? "⊓"
                                            : row.kind == "Any" ? "⊔"
                                            : row.kind == "Not" ? "¬"
                                            : row.kind == "Leaf" ? "◆"
                                            : "◇";
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        color: row.kind == "All" ? #4477dd
                                            : row.kind == "Any" ? #dd6633
                                            : row.kind == "Not" ? #bb44bb
                                            : #44bb66;
                                    }

                                    Text {
                                        text: row.summary;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        color: i == root.constraint-selected ? Palette.selection-foreground : Palette.foreground;
                                    }
                                }
                            }
                        }

                        // Separator
                        Rectangle { height: 1px; background: Palette.border; }

                        // Edit panel
                        HorizontalLayout {
                            height: 22px;
                            spacing: 4px;

                            Text {
                                text: @tr("Params JSON:");
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Button {
                                text: @tr("Delete");
                                height: 22px;
                                enabled: root.constraint-selected >= 0;
                                clicked => { root.constraint-delete-node(root.constraint-selected); }
                            }
                        }

                        TextEdit {
                            height: 110px;
                            text <=> root.constraint-edit-json;
                            font-family: "monospace";
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        Button {
                            height: 26px;
                            text: @tr("Update Constraint");
                            enabled: root.constraint-selected >= 0;
                            clicked => {
                                root.constraint-update-node(
                                    root.constraint-selected,
                                    root.constraint-edit-json
                                );
                            }
                        }
                    }
                }

                // ── Workflow tab ──────────────────────────────────────────────
                Tab {
                    title: @tr("Workflow");
                    VerticalLayout {
                        padding: 4px;
                        spacing: 4px;

                        // Add action buttons
                        HorizontalLayout {
                            height: 28px;
                            spacing: 4px;
                            alignment: start;

                            Text {
                                text: @tr("+ Action:");
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            Button {
                                text: @tr("Notify");
                                height: 24px;
                                clicked => { root.workflow-add-action("Notify"); }
                            }
                            Button {
                                text: @tr("Run");
                                height: 24px;
                                clicked => { root.workflow-add-action("RunCommand"); }
                            }
                            Button {
                                text: @tr("Delay");
                                height: 24px;
                                clicked => { root.workflow-add-action("Delay"); }
                            }
                            Button {
                                text: @tr("Script");
                                height: 24px;
                                clicked => { root.workflow-add-action("RunScript"); }
                            }
                            Button {
                                text: @tr("Interact");
                                height: 24px;
                                clicked => { root.workflow-add-action("Interact"); }
                            }

                            Rectangle { width: 8px; }

                            Text {
                                text: @tr("Control:");
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            Button {
                                text: @tr("If");
                                height: 24px;
                                clicked => { root.workflow-add-if(); }
                            }
                            Button {
                                text: @tr("Parallel");
                                height: 24px;
                                clicked => { root.workflow-add-parallel(); }
                            }
                        }

                        // Workflow tree list
                        ListView {
                            vertical-stretch: 1;
                            min-height: 100px;

                            for row[i] in root.workflow-rows: Rectangle {
                                height: 26px;
                                background: i == root.workflow-selected
                                    ? Palette.selection-background
                                    : (mod(i, 2) == 0 ? Palette.alternate-background : Palette.background);
                                border-radius: 3px;

                                TouchArea {
                                    clicked => {
                                        root.workflow-selected = i;
                                        root.workflow-node-selected(i);
                                    }
                                }

                                HorizontalLayout {
                                    padding-top: 2px;
                                    padding-bottom: 2px;
                                    padding-left: 4px;
                                    spacing: 0px;

                                    // Depth indent
                                    Rectangle { width: row.depth * 16px; }

                                    // Kind icon
                                    Text {
                                        width: 20px;
                                        text: row.kind == "Action" ? "▣"
                                            : row.kind == "Seq" ? "↓"
                                            : row.kind == "Parallel" ? "⇉"
                                            : row.kind == "If" ? "?"
                                            : row.kind == "While" ? "↺"
                                            : row.kind == "Then" ? "▷"
                                            : row.kind == "Else" ? "▶"
                                            : "○";
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        color: row.kind == "Action" ? #44aa77
                                            : row.kind == "If" ? #bbaa33
                                            : row.kind == "Parallel" ? #4477bb
                                            : Palette.foreground;
                                    }

                                    Text {
                                        text: row.summary;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        color: i == root.workflow-selected ? Palette.selection-foreground : Palette.foreground;
                                    }
                                }
                            }
                        }

                        // Separator
                        Rectangle { height: 1px; background: Palette.border; }

                        // Target selector (for Interact actions)
                        HorizontalLayout {
                            height: 26px;
                            spacing: 4px;

                            Text {
                                text: @tr("Target:");
                                font-size: 11px;
                                vertical-alignment: center;
                                width: 46px;
                            }

                            ComboBox {
                                model: ["Foreground", "Window", "Process", "BrowserTab"];
                                current-value <=> root.target-type;
                                height: 24px;
                                width: 110px;
                            }

                            TextEdit {
                                text <=> root.target-pattern;
                                font-size: 11px;
                                horizontal-stretch: 1;
                                height: 24px;
                                enabled: root.target-type != "Foreground";
                            }

                            Text {
                                text: @tr("OnNoBg:");
                                font-size: 11px;
                                vertical-alignment: center;
                                width: 52px;
                            }

                            ComboBox {
                                model: ["Degrade", "Fail", "Queue"];
                                current-value <=> root.on-no-bg;
                                height: 24px;
                                width: 80px;
                            }
                        }

                        // Params edit
                        HorizontalLayout {
                            height: 22px;
                            spacing: 4px;

                            Text {
                                text: @tr("Params JSON:");
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Button {
                                text: @tr("Delete");
                                height: 22px;
                                enabled: root.workflow-selected >= 0;
                                clicked => { root.workflow-delete-node(root.workflow-selected); }
                            }
                        }

                        TextEdit {
                            height: 90px;
                            text <=> root.workflow-edit-json;
                            font-family: "monospace";
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        Button {
                            height: 26px;
                            text: @tr("Update Action");
                            enabled: root.workflow-selected >= 0;
                            clicked => {
                                root.workflow-update-node(
                                    root.workflow-selected,
                                    root.workflow-edit-json
                                );
                            }
                        }
                    }
                }
            }

            // Horizontal separator
            Rectangle {
                height: 1px;
                background: Palette.border;
            }

            // Log panel
            VerticalLayout {
                height: 130px;
                padding: 6px;
                spacing: 2px;

                Text {
                    text: @tr("Log");
                    font-size: 12px;
                    font-weight: 700;
                    height: 18px;
                }

                ListView {
                    vertical-stretch: 1;

                    for entry in root.logs: Text {
                        text: entry.message;
                        font-family: "monospace";
                        font-size: 11px;
                        height: 16px;
                    }
                }
            }
        }
    }
}