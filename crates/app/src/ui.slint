import { Button, CheckBox, ListView, TabWidget, TextEdit } from "std-widgets.slint";

export struct MacroItem {
    id: string,
    name: string,
    enabled: bool,
}

export struct LogEntry {
    message: string,
}

export component MainWindow inherits Window {
    width: 920px;
    height: 620px;
    title: "Koakuma — Automation Engine";

    // ── Model properties ──────────────────────────────────────────────────────
    in property <[MacroItem]> macros;
    in-out property <int> selected-index: -1;
    in property <string> selected-triggers: "";
    in property <string> selected-constraints: "";
    in property <string> selected-actions: "";
    in property <[LogEntry]> logs;

    // ── Callbacks ─────────────────────────────────────────────────────────────
    callback add-macro();
    callback delete-macro(int);
    callback toggle-enabled(int, bool);
    callback trigger-macro(int);
    callback macro-selected(int);

    HorizontalLayout {
        spacing: 0px;

        // ── Left panel: macro list ────────────────────────────────────────────
        VerticalLayout {
            width: 270px;
            padding: 8px;
            spacing: 6px;

            Text {
                text: "Macros";
                font-size: 14px;
                font-weight: 700;
            }

            ListView {
                vertical-stretch: 1;

                for item[idx] in root.macros: Rectangle {
                    height: 44px;
                    background: idx == root.selected-index ? #dce8f8 : transparent;
                    border-radius: 5px;

                    // Background TouchArea for row selection (lower z-order)
                    TouchArea {
                        clicked => {
                            root.selected-index = idx;
                            root.macro-selected(idx);
                        }
                    }

                    HorizontalLayout {
                        padding: 4px;
                        spacing: 4px;
                        alignment: center;

                        CheckBox {
                            checked: item.enabled;
                            toggled => { root.toggle-enabled(idx, self.checked); }
                        }

                        Text {
                            text: item.name;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                            font-size: 12px;
                        }

                        Button {
                            text: "▶";
                            width: 28px;
                            height: 28px;
                            clicked => {
                                root.selected-index = idx;
                                root.trigger-macro(idx);
                                root.macro-selected(idx);
                            }
                        }

                        Button {
                            text: "✕";
                            width: 28px;
                            height: 28px;
                            clicked => { root.delete-macro(idx); }
                        }
                    }
                }
            }

            Button {
                text: "+ Add Macro";
                clicked => { root.add-macro(); }
            }
        }

        // Vertical separator
        Rectangle {
            width: 1px;
            background: #cccccc;
        }

        // ── Right panel: editor + log ─────────────────────────────────────────
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;

            // 3-tab editor
            TabWidget {
                vertical-stretch: 1;

                Tab {
                    title: "Triggers";
                    TextEdit {
                        text: root.selected-triggers;
                        read-only: true;
                        font-family: "monospace";
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }

                Tab {
                    title: "Constraints";
                    TextEdit {
                        text: root.selected-constraints;
                        read-only: true;
                        font-family: "monospace";
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }

                Tab {
                    title: "Actions";
                    TextEdit {
                        text: root.selected-actions;
                        read-only: true;
                        font-family: "monospace";
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }

            // Horizontal separator
            Rectangle {
                height: 1px;
                background: #cccccc;
            }

            // Log panel
            VerticalLayout {
                height: 155px;
                padding: 6px;
                spacing: 2px;

                Text {
                    text: "Log";
                    font-size: 12px;
                    font-weight: 700;
                    height: 18px;
                }

                ListView {
                    vertical-stretch: 1;

                    for entry in root.logs: Text {
                        text: entry.message;
                        font-family: "monospace";
                        font-size: 11px;
                        height: 16px;
                    }
                }
            }
        }
    }
}